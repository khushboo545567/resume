# Resume API (Throne8 backend, resume-builder routes)
VITE_API_URL=http://localhost:4000/api/v1/resume-builder

# Throne8 auth API (profile / refresh-token / logout).
# Optional: defaults to VITE_API_URL without the trailing /resume-builder.
# VITE_AUTH_API_URL=http://localhost:4000/api/v1

# Throne8 web app (login/signup live there). Defaults: http://localhost:3000 in dev, https://throne8.com in production.
# VITE_THRONE8_URL=http://localhost:3000

# ---- Production (set these in Vercel) ----
# VITE_API_URL=https://api.throne8.com/api/v1/resume-builder
# VITE_THRONE8_URL=https://throne8.com
